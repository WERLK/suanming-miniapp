/* ===== 玄机算命 小程序全局样式 ===== */

/* --- CSS 变量（自定义属性）--- */
page {
  --bg-primary: #0f0c29;
  --bg-secondary: #1a1a2e;
  --bg-card: rgba(26, 26, 46, 0.85);
  --bg-card-hover: rgba(40, 40, 70, 0.9);
  --text-primary: #ffffff;
  --text-secondary: #b0b0c8;
  --text-muted: #8888a0;
  --accent: #ffd700;
  --accent-light: rgba(255, 215, 0, 0.15);
  --accent-border: rgba(255, 215, 0, 0.3);
  --success: #27ae60;
  --danger: #e74c3c;
  --warning: #f39c12;
  --border-radius: 16rpx;

  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  min-height: 100vh;
}

/* --- 通用页面容器 --- */
.page-container {
  padding: 24rpx;
  padding-bottom: 120rpx; /* 留出 TabBar 空间 */
  min-height: 100vh;
  box-sizing: border-box;
}

/* --- 卡片 --- */
.card {
  background: var(--bg-card);
  border-radius: var(--border-radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  transition: all 0.3s ease;
}

.card-gold {
  border-color: var(--accent-border);
  background: linear-gradient(135deg, rgba(15, 12, 41, 0.9), rgba(40, 30, 80, 0.95));
}

.card-glow {
  box-shadow: 0 4rpx 24rpx rgba(255, 215, 0, 0.1);
}

/* --- 按钮 --- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 48rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s ease;
}

.btn-primary {
  background: linear-gradient(135deg, #ffd700, #f0a500);
  color: #1a1a2e;
  box-shadow: 0 4rpx 16rpx rgba(255, 215, 0, 0.3);
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-secondary {
  background: var(--bg-secondary);
  color: var(--accent);
  border: 2rpx solid var(--accent-border);
}

.btn-block {
  width: 100%;
}

.btn-sm {
  height: 64rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
}

.btn-disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* --- 输入框 --- */
.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.input-field {
  width: 100%;
  height: 88rpx;
  background: var(--bg-secondary);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: var(--border-radius);
  padding: 0 24rpx;
  color: var(--text-primary);
  font-size: 28rpx;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: var(--accent);
}

/* --- 文字 --- */
.text-center { text-align: center; }
.text-right { text-align: right; }
.text-gold { color: var(--accent); }
.text-muted { color: var(--text-muted); }
.text-sm { font-size: 24rpx; }
.text-lg { font-size: 34rpx; }
.text-xl { font-size: 40rpx; }
.font-bold { font-weight: bold; }

/* --- 布局 --- */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 { flex: 1; }

/* --- 间距 --- */
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.p-16 { padding: 16rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }

/* --- 分割线 --- */
.divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.08);
  margin: 24rpx 0;
}

/* --- Toast 消息 --- */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.8);
  color: #fff;
  padding: 24rpx 48rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  z-index: 9999;
  white-space: nowrap;
}

.toast-success {
  border: 2rpx solid var(--success);
}

.toast-error {
  border: 2rpx solid var(--danger);
}

/* --- Badge / 标签 --- */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.badge-gold {
  background: var(--accent-light);
  color: var(--accent);
  border: 1rpx solid var(--accent-border);
}

.badge-green {
  background: rgba(39, 174, 96, 0.15);
  color: var(--success);
}

.badge-red {
  background: rgba(231, 76, 60, 0.15);
  color: var(--danger);
}

/* --- 网格布局 --- */
.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.grid-4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

/* --- 加载指示器 --- */
.loading-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  color: var(--text-muted);
  font-size: 26rpx;
  margin-top: 16rpx;
}

/* --- 空状态 --- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-state text {
  color: var(--text-muted);
  font-size: 28rpx;
  margin-top: 16rpx;
}

/* --- 渐变文字 --- */
.gradient-text {
  background: linear-gradient(135deg, #ffd700, #f0a500, #ff6b6b);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
