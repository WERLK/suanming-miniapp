/* pages/profile/profile 个人中心 */

/* 用户信息 */
.profile-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.profile-avatar-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 3rpx solid rgba(255, 215, 0, 0.4);
  flex-shrink: 0;
}

.profile-avatar {
  width: 100%;
  height: 100%;
}

.profile-avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  background: rgba(255, 255, 255, 0.06);
}

.profile-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.profile-username {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.profile-email {
  font-size: 24rpx;
  color: #888;
  margin-top: 2rpx;
}

/* 菜单 */
.profile-menu {
  padding: 8rpx 0;
  margin-bottom: 40rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  transition: background 0.15s ease;
}

.menu-item:active {
  background: rgba(255, 255, 255, 0.04);
}

.menu-item + .menu-item {
  border-top: 1rpx solid rgba(255, 255, 255, 0.04);
}

.menu-item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-item-icon {
  font-size: 36rpx;
  width: 48rpx;
  text-align: center;
}

.menu-item-label {
  font-size: 28rpx;
  color: #e0e0f0;
}

.menu-item-arrow {
  font-size: 36rpx;
  color: #555;
  font-weight: 300;
}

/* 退出按钮 */
.logout-btn {
  width: 100%;
  height: 88rpx;
  background: rgba(231, 76, 60, 0.1);
  color: #e74c3c;
  border: 1rpx solid rgba(231, 76, 60, 0.2);
  border-radius: 16rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 未登录 */
.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.login-prompt-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.login-prompt-text {
  font-size: 32rpx;
  color: #888;
}

.bottom-safe {
  height: 40rpx;
}
