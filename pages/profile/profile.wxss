.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}

.login-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.login-text {
  font-size: 30rpx;
  color: #888;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: linear-gradient(135deg, rgba(15, 12, 41, 0.9), rgba(40, 30, 80, 0.95));
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 215, 0, 0.15);
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4a2d8f, #2d1b69);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-placeholder {
  font-size: 40rpx;
  color: #ffd700;
  font-weight: bold;
}

.user-info {
  flex: 1;
}

.username {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.arrow {
  font-size: 36rpx;
  color: #666;
}

.vip-promo {
  margin-bottom: 24rpx;
}

.vip-promo-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #ffd700;
  margin-bottom: 4rpx;
}

.vip-promo-desc {
  font-size: 24rpx;
  color: #888;
}

.menu-section {
  margin-bottom: 24rpx;
}

.menu-section-title {
  display: block;
  font-size: 24rpx;
  color: #888;
  padding: 0 16rpx;
  margin-bottom: 12rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: rgba(26, 26, 46, 0.85);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.menu-item:first-child {
  border-radius: 12rpx 12rpx 0 0;
}

.menu-item:last-child {
  border-radius: 0 0 12rpx 12rpx;
  border-bottom: none;
}

.menu-item:active {
  background: rgba(255, 215, 0, 0.05);
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #e0e0ff;
}

.menu-arrow {
  font-size: 32rpx;
  color: #666;
}

.logout-section {
  padding: 32rpx 0;
}

.footer {
  text-align: center;
  padding: 24rpx 0;
}

.footer-text {
  font-size: 22rpx;
  color: #555;
}

.user-meta {
  margin-top: 4rpx;
}
