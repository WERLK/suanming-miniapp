<!-- pages/profile/profile - 个人中心 -->

<!-- 已登录 -->
<view wx:if="{{isLoggedIn}}" class="page-container">
  <!-- 用户信息卡片 -->
  <view class="profile-header card card-glow">
    <view class="profile-avatar-wrap">
      <image wx:if="{{avatar}}" class="profile-avatar" src="{{avatar}}" mode="aspectFill" />
      <view wx:else class="profile-avatar-placeholder">👤</view>
    </view>
    <view class="profile-info">
      <text class="profile-username">{{username || '用户'}}</text>
      <vip-badge level="{{vipLevel}}" small="{{true}}" />
      <text wx:if="{{email}}" class="profile-email">{{email}}</text>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="profile-menu card">
    <view class="menu-item"
          wx:for="{{menuItems}}" wx:key="label"
          bind:tap="navigateTo"
          data-url="{{item.url}}">
      <view class="menu-item-left">
        <text class="menu-item-icon">{{item.icon}}</text>
        <text class="menu-item-label">{{item.label}}</text>
      </view>
      <text class="menu-item-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <button class="logout-btn" bind:tap="doLogout">退出登录</button>

  <view class="bottom-safe"></view>
</view>

<!-- 未登录 -->
<view wx:else class="page-container">
  <view class="login-prompt">
    <text class="login-prompt-icon">🔮</text>
    <text class="login-prompt-text">登录后解锁更多功能</text>
    <button class="btn btn-primary" style="margin-top:32rpx;" bind:tap="goToLogin">
      立即登录
    </button>
  </view>
</view>
