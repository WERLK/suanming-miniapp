<view class="page-container">
  <text class="page-title">📊 我的报告</text>
  <view wx:if="{{loading}}" class="loading-wrapper"><text class="loading-text">加载中...</text></view>
  <view wx:elif="{{items.length===0}}" class="empty-state"><text>暂无生成报告</text></view>
  <block wx:else>
    <view class="card" wx:for="{{items}}" wx:key="id">
      <text class="history-name">{{item.title||'算命报告'}}</text>
      <text class="history-time">{{item.created_at}}</text>
    </view>
  </block>
</view>
