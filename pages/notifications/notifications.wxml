<view class="page-container">
  <view class="settings-card card" wx:for="{{['daily_fortune','checkin_reminder','ad_available']}}" wx:key="*this">
    <view class="setting-row"><text class="setting-label">{{item==='daily_fortune'?'每日运势提醒':item==='checkin_reminder'?'签到提醒':'广告可用通知'}}</text>
    <switch checked="{{settings[item]||false}}" bindchange="onToggle" data-key="{{item}}" color="#ffd700"/></view></view>
</view>