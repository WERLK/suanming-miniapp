.module-title { display:block; font-size:36rpx; font-weight:bold; color:#ffd700; text-align:center; margin-bottom:24rpx; }
.form-title { display:block; font-size:28rpx; color:#e0e0ff; margin-bottom:16rpx; font-weight:500; }
.form-row { display:flex; gap:20rpx; margin-bottom:16rpx; }
.form-col { flex:1; }
.picker-field { display:flex; align-items:center; }
.image-upload { width:100%; height:360rpx; border-radius:16rpx; border:2rpx dashed rgba(255,215,0,0.2); overflow:hidden; background:rgba(255,255,255,0.03); }
.upload-preview { width:100%; height:100%; }
.upload-placeholder { display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; }
.upload-icon { font-size:72rpx; margin-bottom:12rpx; }
.upload-text { font-size:26rpx; color:#888; }
.error-box { padding:24rpx; background:rgba(231,76,60,0.1); border-radius:12rpx; border:1rpx solid rgba(231,76,60,0.3); margin-bottom:24rpx; }
.error-text { color:#e74c3c; font-size:26rpx; }
.result-section { margin-top:24rpx; }
.result-header { padding:16rpx 0; border-bottom:1rpx solid rgba(255,255,255,0.08); margin-bottom:16rpx; }
.result-title { font-size:28rpx; font-weight:bold; color:#ffd700; }
.result-actions { display:flex; gap:24rpx; }
.action-btn { font-size:36rpx; }
.result-scroll { max-height:800rpx; }
.result-content { padding:24rpx; background:rgba(255,255,255,0.03); border-radius:12rpx; line-height:1.8; }
.result-text { font-size:28rpx; color:#e0e0ff; white-space:pre-wrap; }
