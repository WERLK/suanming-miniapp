<view class="page-container">
  <view class="module-header"><text class="module-icon">{{moduleIcon}}</text><text class="module-name">{{moduleName}}</text></view>
  <view class="module-form card"><view class="input-group" wx:for="{{['name','birth_date','gender']}}" wx:key="*this">
    <text class="input-label">{{item==='name'?'姓名/昵称':item==='birth_date'?'出生日期':'性别'}}</text>
    <input class="input-field" placeholder="{{item==='birth_date'?'如：2000-01-01':item==='gender'?'如：男':'请输入'}}" data-key="{{item}}" bindinput="onInput"/></view>
    <button class="btn btn-primary btn-block" bind:tap="doSubmit" loading="{{loading}}" disabled="{{loading}}">{{loading?"计算中...":"开始算命"}}</button></view>
  <view class="module-result card" wx:if="{{result}}"><text class="result-title">🔮 算命结果</text>
    <view class="result-content"><text>{{result.result||result.analysis||JSON.stringify(result)}}</text></view></view>
</view>