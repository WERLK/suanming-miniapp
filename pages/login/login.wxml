<!-- pages/login/login -->
<view class="page-container">
  <view class="login-header">
    <text class="login-icon">🔮</text>
    <text class="login-title">玄机算命</text>
    <text class="login-subtitle">登录你的账号</text>
  </view>

  <view class="login-form card">
    <view class="input-group">
      <text class="input-label">用户名 / 手机号 / 邮箱</text>
      <input class="input-field" placeholder="请输入用户名" placeholder-class="input-placeholder"
             value="{{username}}" bindinput="onUsernameInput" />
    </view>
    <view class="input-group">
      <text class="input-label">密码</text>
      <input class="input-field" type="password" placeholder="请输入密码" placeholder-class="input-placeholder"
             value="{{password}}" bindinput="onPasswordInput" />
    </view>
    <button class="btn btn-primary btn-block" bind:tap="doLogin" loading="{{loading}}" disabled="{{loading}}">
      {{loading ? '登录中...' : '登录'}}
    </button>
  </view>

  <view class="login-links">
    <text class="link-item" bind:tap="goToRegister">没有账号？立即注册</text>
    <text class="link-item" bind:tap="goToForgotPassword">忘记密码？</text>
  </view>
</view>
