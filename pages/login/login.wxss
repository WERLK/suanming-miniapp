/* pages/login/login */

.login-header {
  text-align: center;
  padding: 80rpx 0 56rpx;
}

.login-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #ffd700, #f0a500, #ff6b6b);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: block;
  margin-bottom: 12rpx;
}

.login-subtitle {
  font-size: 26rpx;
  color: #888;
}

.login-form {
  margin-bottom: 32rpx;
}

.login-form .btn {
  margin-top: 32rpx;
}

.input-placeholder {
  color: #555;
}

.login-links {
  display: flex;
  justify-content: space-between;
  padding: 0 16rpx;
}

.link-item {
  font-size: 26rpx;
  color: #888;
}

.link-item:active {
  color: #ffd700;
}
