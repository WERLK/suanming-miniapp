.login-header { text-align: center; padding: 60rpx 0 40rpx; }
.login-title { font-size: 52rpx; font-weight: bold; margin-bottom: 12rpx; }
.login-subtitle { display: block; font-size: 26rpx; color: #888; }
.login-form { padding: 0 16rpx; }
.check-box { width: 36rpx; height: 36rpx; border-radius: 6rpx; border: 2rpx solid #666; display: flex; align-items:center; justify-content:center; margin-right:10rpx; }
.check-box.checked { background: #ffd700; border-color:#ffd700; color:#1a1a2e; font-size:22rpx; }
.check-label { font-size: 26rpx; color: #888; }
.login-footer { text-align: center; padding: 40rpx 0; }
.register-link { font-size: 26rpx; color: #ffd700; }
