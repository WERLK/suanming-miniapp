.page-title{display:block;font-size:32rpx;font-weight:bold;color:#ffd700;margin-bottom:24rpx}.faq-item{padding:24rpx}.faq-q{font-size:28rpx;font-weight:500;color:#e0e0ff;flex:1}.faq-arrow{font-size:22rpx;color:#888;transition:transform 0.3s;flex-shrink:0;margin-left:16rpx}.faq-arrow.open{transform:rotate(90deg)}.faq-a{max-height:0;overflow:hidden;transition:max-height 0.3s ease;font-size:26rpx;color:#888;line-height:1.8;padding:0}.faq-a.open{max-height:500rpx;padding-top:16rpx}