/* pages/register/register - 复用登录页样式 */

.login-header { text-align: center; padding: 60rpx 0 40rpx; }
.login-icon { font-size: 72rpx; display: block; margin-bottom: 16rpx; }
.login-title { font-size: 40rpx; font-weight: 700; background: linear-gradient(135deg, #ffd700, #f0a500, #ff6b6b); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; display: block; margin-bottom: 10rpx; }
.login-subtitle { font-size: 26rpx; color: #888; }
.login-form { margin-bottom: 24rpx; }
.login-form .btn { margin-top: 24rpx; }
.input-placeholder { color: #555; }
.link-item { font-size: 26rpx; color: #888; }
.link-item:active { color: #ffd700; }
