<view class="page-container">
  <text class="page-title">📜 算命历史</text>
  <view wx:if="{{loading}}" class="loading-wrapper"><text class="loading-text">加载中...</text></view>
  <view wx:elif="{{items.length === 0}}" class="empty-state"><text>暂无算命记录</text></view>
  <block wx:else>
    <view class="history-item card" wx:for="{{items}}" wx:key="id" bindtap="onTapItem" data-file="{{item.module_file}}" data-name="{{item.module_name}}">
      <view class="flex-between"><text class="history-name">{{item.module_name}}</text><text class="history-time">{{item.created_at}}</text></view>
      <text class="history-summary" wx:if="{{item.result_summary}}">{{item.result_summary}}</text>
    </view>
    <view wx:if="{{hasMore}}" class="loading-wrapper" style="padding:24rpx"><text class="loading-text">上拉加载更多</text></view>
  </block>
</view>
