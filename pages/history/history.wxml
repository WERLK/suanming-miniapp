<view class="page-container">
  <block wx:if="{{!loading && historyList.length > 0}}">
    <view class="list-card card" wx:for="{{historyList}}" wx:key="id" bind:tap="onItemTap">
      <view class="list-item-row">
        <text class="list-item-icon">🔮</text>
        <view class="list-item-body">
          <text class="list-item-title">{{item.module_name || item.name || '算命记录'}}</text>
          <text class="list-item-desc">{{item.created_at || item.date || ''}}</text></view>
        <text class="list-item-arrow">›</text></view></view></block>
  <view class="empty-state" wx:if="{{!loading && historyList.length === 0}}">
    <text>📜</text><text>暂无历史记录</text></view>
  <view class="loading-wrapper" wx:if="{{loading}}"><text class="loading-text">加载中...</text></view>
</view>