<!-- pages/vip/vip - 会员中心 -->
<view class="page-container">
  <!-- VIP 信息卡片 -->
  <view class="vip-hero card card-gold card-glow">
    <view class="vip-hero-top">
      <view class="vip-level-row">
        <text class="vip-hero-icon">👑</text>
        <vip-badge level="{{vipLevel}}" />
      </view>
      <view class="vip-points-row">
        <text class="vip-points-value">{{points}}</text>
        <text class="vip-points-label">积分</text>
      </view>
    </view>
    <!-- 每日使用进度 -->
    <view class="vip-usage">
      <view class="vip-usage-label">今日使用: {{dailyUses}} / {{maxDailyUses}}</view>
      <view class="vip-usage-bar">
        <view class="vip-usage-fill" style="width: {{dailyUses / maxDailyUses * 100}}%;"></view>
      </view>
    </view>
    <!-- 会员权益 -->
    <view class="vip-benefits" wx:if="{{vipLevel !== 'free'}}">
      <text class="vip-benefits-title">会员权益</text>
      <view class="vip-benefits-list">
        <text>📊 详细命理报告</text>
        <text>🤖 AI深度分析</text>
        <text>📈 运势趋势图</text>
        <text>♾️ 无限算命次数</text>
        <text>🎁 专属签到奖励</text>
        <text>🎡 幸运转盘</text>
      </view>
    </view>
  </view>

  <!-- 签到 -->
  <view class="section card">
    <view class="section-row">
      <view class="section-info">
        <text class="section-label">📅 每日签到</text>
        <text class="section-desc">签到可获 {{checkinPoints}} 积分</text>
      </view>
      <button class="btn btn-sm {{checkinDone ? 'btn-disabled' : 'btn-primary'}}"
              bind:tap="doCheckin"
              disabled="{{checkinDone}}">
        {{checkinDone ? '✅ 已签到' : '签到领积分'}}
      </button>
    </view>
  </view>

  <!-- 看广告 -->
  <view class="section card">
    <view class="section-row">
      <view class="section-info">
        <text class="section-label">📺 看广告</text>
        <text class="section-desc">观看广告获得 VIP 时长</text>
      </view>
      <button class="btn btn-sm btn-primary" bind:tap="watchAdForVIP">
        立即观看
      </button>
    </view>
  </view>

  <!-- 幸运转盘 -->
  <view class="section card">
    <view class="section-title">
      <text class="section-title-text">🎡 幸运转盘</text>
      <text class="section-title-sub">每日 {{spinsLeft || 0}} 次</text>
    </view>
    <wheel-canvas
      id="vipWheel"
      segments="{{wheelSegments}}"
      spinsLeft="{{spinsLeft}}"
      disabled="{{spinsLeft <= 0}}"
      bind:spin="spinWheel"
      bind:spinend="onWheelSpinEnd"
    />
  </view>

  <!-- 积分兑换 -->
  <view class="section card">
    <view class="section-title">
      <text class="section-title-text">🎁 积分兑换</text>
    </view>
    <view class="redeem-grid">
      <view class="redeem-item"
            wx:for="{{redeemOptions}}"
            wx:key="type"
            bind:tap="doRedeem"
            data-type="{{item.type}}"
            data-cost="{{item.cost}}"
            data-label="{{item.label}}">
        <text class="redeem-icon">{{item.icon}}</text>
        <text class="redeem-label">{{item.label}}</text>
        <text class="redeem-cost">{{item.cost}} 积分</text>
      </view>
    </view>
  </view>

  <!-- 广告弹窗 -->
  <ad-modal
    visible="{{showAdModal}}"
    title="{{adTitle}}"
    seconds="{{5}}"
    tipText="{{adTip}}"
    bind:claim="claimAdReward"
    bind:close="closeAdModal"
  />

  <view class="bottom-safe"></view>
</view>
