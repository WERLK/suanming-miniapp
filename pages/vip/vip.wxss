.vip-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
  background: linear-gradient(180deg, rgba(45, 27, 105, 0.4), transparent);
  border-radius: 24rpx;
}

.vip-points {
  text-align: center;
  margin-top: 24rpx;
}

.points-label {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 4rpx;
}

.points-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #ffd700;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #ffd700;
  margin-bottom: 8rpx;
}

.section-desc {
  display: block;
  font-size: 24rpx;
  color: #888;
}

.benefits-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
}

.benefit-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
}

.benefit-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.benefit-text {
  font-size: 22rpx;
  color: #b0b0c8;
  text-align: center;
}

.card-gold {
  border-color: rgba(255, 215, 0, 0.3);
  background: linear-gradient(135deg, rgba(15, 12, 41, 0.9), rgba(40, 30, 80, 0.95));
}

.redeem-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.redeem-card:active {
  background: rgba(255, 215, 0, 0.08);
  border-color: rgba(255, 215, 0, 0.2);
}

.redeem-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #e0e0ff;
  margin-bottom: 8rpx;
}

.redeem-cost {
  font-size: 24rpx;
  color: #ffd700;
}
