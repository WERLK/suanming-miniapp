/* pages/vip/vip 会员中心 */

/* VIP Hero */
.vip-hero {
  text-align: center;
  padding: 40rpx 32rpx;
}

.vip-hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.vip-level-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.vip-hero-icon {
  font-size: 48rpx;
}

.vip-points-row {
  text-align: right;
}

.vip-points-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffd700;
  display: block;
}

.vip-points-label {
  font-size: 24rpx;
  color: #888;
}

/* 进度条 */
.vip-usage {
  margin-bottom: 28rpx;
}

.vip-usage-label {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 10rpx;
}

.vip-usage-bar {
  height: 10rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 5rpx;
  overflow: hidden;
}

.vip-usage-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffd700, #f0a500);
  border-radius: 5rpx;
  transition: width 0.5s ease;
}

/* 权益 */
.vip-benefits-title {
  font-size: 26rpx;
  color: #ffd700;
  margin-bottom: 12rpx;
  display: block;
}

.vip-benefits-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
}

.vip-benefits-list text {
  font-size: 22rpx;
  color: #b0b0c8;
  background: rgba(255,215,0,0.06);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

/* Section */
.section {
  margin-bottom: 24rpx;
}

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-info {
  display: flex;
  flex-direction: column;
}

.section-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #e0e0f0;
}

.section-desc {
  font-size: 24rpx;
  color: #888;
  margin-top: 4rpx;
}

.section-title {
  text-align: center;
  margin-bottom: 24rpx;
}

.section-title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #e0e0f0;
}

.section-title-sub {
  font-size: 24rpx;
  color: #888;
  display: block;
  margin-top: 4rpx;
}

/* 兑换网格 */
.redeem-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.redeem-item {
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  transition: all 0.15s ease;
}

.redeem-item:active {
  background: rgba(255,215,0,0.08);
  border-color: rgba(255,215,0,0.2);
}

.redeem-icon {
  font-size: 40rpx;
  display: block;
  margin-bottom: 8rpx;
}

.redeem-label {
  font-size: 26rpx;
  color: #e0e0f0;
  display: block;
  margin-bottom: 4rpx;
}

.redeem-cost {
  font-size: 22rpx;
  color: #ffd700;
}

.bottom-safe {
  height: 40rpx;
}
