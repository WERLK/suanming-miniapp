.page-title{display:block;font-size:32rpx;font-weight:bold;color:#ffd700;margin-bottom:32rpx}.avatar-section{display:flex;flex-direction:column;align-items:center;padding:32rpx 0;margin-bottom:24rpx}.avatar-preview{width:160rpx;height:160rpx;border-radius:50%;border:3rpx solid rgba(255,215,0,0.3)}.avatar-placeholder-lg{width:160rpx;height:160rpx;border-radius:50%;background:linear-gradient(135deg,#4a2d8f,#2d1b69);display:flex;align-items:center;justify-content:center;font-size:60rpx}.avatar-hint{font-size:24rpx;color:#888;margin-top:12rpx}