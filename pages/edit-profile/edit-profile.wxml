<view class="page-container">
  <view class="form-card card"><view class="input-group"><text class="input-label">用户名</text>
  <input class="input-field" value="{{username}}" data-field="username" bindinput="onInput"/></view>
  <view class="input-group"><text class="input-label">邮箱</text>
  <input class="input-field" value="{{email}}" data-field="email" bindinput="onInput"/></view>
  <button class="btn btn-primary btn-block" bind:tap="doSave">保存</button></view>
</view>