/* pages/index/index 首页样式 */

/* Hero */
.hero-section {
  text-align: center;
  padding: 56rpx 0 40rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #ffd700 0%, #f0a500 40%, #ff6b6b 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: block;
  margin-bottom: 16rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  color: #8888a0;
  display: block;
  margin-bottom: 40rpx;
}

.hero-cta {
  display: flex;
  gap: 20rpx;
  justify-content: center;
  flex-wrap: wrap;
}

.hero-cta .btn {
  flex: 1;
  min-width: 220rpx;
  max-width: 300rpx;
}

/* Section */
.section {
  margin-bottom: 40rpx;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 12rpx;
}

.section-title-bar {
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #ffd700, #f0a500);
  border-radius: 3rpx;
}

.section-title text {
  font-size: 32rpx;
  font-weight: 600;
  color: #e0e0f0;
}

/* Grids */
.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

/* Knowledge Cards */
.knowledge-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.knowledge-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  background: rgba(26, 26, 46, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 24rpx;
}

.knowledge-icon {
  font-size: 44rpx;
  flex-shrink: 0;
  width: 64rpx;
  text-align: center;
}

.knowledge-body {
  flex: 1;
}

.knowledge-title {
  display: block;
  font-size: 28rpx;
  color: #ffd700;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.knowledge-desc {
  font-size: 24rpx;
  color: #8888a0;
  line-height: 1.6;
}

.bottom-safe {
  height: 40rpx;
}
