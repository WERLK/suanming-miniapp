/* pages/more/more 分类页样式 */

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: rgba(26, 26, 46, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 80rpx;
  margin-bottom: 32rpx;
  gap: 12rpx;
}

.search-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  height: 100%;
  color: #e0e0f0;
  font-size: 28rpx;
}

.search-placeholder {
  color: #666;
}

.search-clear {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #888;
  flex-shrink: 0;
  border-radius: 50%;
}

.search-clear:active {
  background: rgba(255, 255, 255, 0.1);
}

/* 分类列表 */
.categories-list {
  padding-bottom: 40rpx;
}

.bottom-safe {
  height: 40rpx;
}
