<view class="page-container">
  <view class="settings-card card" wx:for="{{['show_fortune_result','share_enabled','save_history']}}" wx:key="*this">
    <view class="setting-row"><text class="setting-label">{{item==='show_fortune_result'?'显示算命结果':item==='share_enabled'?'允许分享':'保存历史记录'}}</text>
    <switch checked="{{settings[item]||false}}" bindchange="onToggle" data-key="{{item}}" color="#ffd700"/></view></view>
</view>