<view class="fortune-card {{isHot ? 'fortune-card-hot' : ''}}" bind:tap="onTap">
  <view class="fortune-card-icon">{{icon}}</view>
  <view class="fortune-card-name">{{name}}</view>
  <view class="fortune-card-badges" wx:if="{{isNew || isHot}}">
    <text class="fortune-badge fortune-badge-new" wx:if="{{isNew}}">NEW</text>
    <text class="fortune-badge fortune-badge-hot" wx:if="{{isHot}}">🔥 热门</text>
  </view>
</view>
