/* fortune-card 组件样式 */

.fortune-card {
  background: rgba(26, 26, 46, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  transition: all 0.15s ease;
  position: relative;
  overflow: hidden;
}

.fortune-card:active {
  background: rgba(40, 40, 70, 0.9);
  transform: scale(0.96);
}

.fortune-card-hot {
  border-color: rgba(255, 215, 0, 0.3);
  box-shadow: 0 4rpx 16rpx rgba(255, 215, 0, 0.06);
}

.fortune-card-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
  display: block;
}

.fortune-card-name {
  font-size: 26rpx;
  color: #b0b0c8;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fortune-card-badges {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.fortune-badge {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 600;
  line-height: 1.4;
}

.fortune-badge-new {
  background: rgba(39, 174, 96, 0.2);
  color: #27ae60;
}

.fortune-badge-hot {
  background: rgba(231, 76, 60, 0.18);
  color: #e74c3c;
}
