.fortune-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(26, 26, 46, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  transition: all 0.2s ease;
}

.fortune-card.card-hover {
  background: rgba(40, 40, 70, 0.95);
  border-color: rgba(255, 215, 0, 0.3);
  transform: scale(0.97);
}

.card-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.card-name {
  font-size: 26rpx;
  color: #e0e0ff;
  font-weight: 500;
  text-align: center;
  line-height: 1.4;
}

.card-desc {
  font-size: 22rpx;
  color: #888;
  text-align: center;
  margin-top: 6rpx;
}

.card-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background: linear-gradient(135deg, #ff6b6b, #ee5a24);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.badge-text {
  font-size: 18rpx;
  color: #fff;
  font-weight: bold;
}
