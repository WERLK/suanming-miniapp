<view class="cat-section">
  <view class="cat-title" bind:tap="toggle">
    <text class="cat-title-text">{{title}}</text>
    <view class="cat-arrow {{expanded ? 'cat-arrow-expanded' : ''}}">▶</view>
  </view>
  <view class="cat-body" wx:if="{{expanded}}">
    <view class="cat-grid">
      <block wx:for="{{modules}}" wx:key="path">
        <view class="cat-module-item"
              data-module="{{item}}"
              bind:tap="onModuleTap">
          <text class="cat-module-icon">{{item.icon || '🔮'}}</text>
          <text class="cat-module-name">{{item.name}}</text>
          <view class="cat-module-badges" wx:if="{{item.isNew || item.isHot}}">
            <text wx:if="{{item.isNew}}" class="cat-badge cat-badge-new">NEW</text>
            <text wx:if="{{item.isHot}}" class="cat-badge cat-badge-hot">🔥</text>
          </view>
        </view>
      </block>
    </view>
  </view>
  <view class="cat-divider"></view>
</view>
