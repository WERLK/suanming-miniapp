/* wheel-canvas 组件样式 */

.wheel-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.wheel-canvas-container {
  position: relative;
  width: 300px;
  height: 300px;
  margin-bottom: 32rpx;
}

.wheel-canvas {
  width: 300px;
  height: 300px;
}

.wheel-controls {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  width: 100%;
}

.wheel-spin-btn {
  width: 360rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #ffd700, #f0a500);
  color: #1a1a2e;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 215, 0, 0.3);
  letter-spacing: 2rpx;
}

.wheel-spin-btn:active {
  opacity: 0.85;
  transform: scale(0.96);
}

.wheel-spin-btn-disabled {
  background: rgba(255, 255, 255, 0.08);
  color: #666;
  box-shadow: none;
  font-weight: 400;
}

.wheel-spin-btn-disabled:active {
  opacity: 1;
  transform: none;
}

.wheel-spins-left {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.spins-text {
  font-size: 26rpx;
  color: #8888a0;
}

.spins-count {
  font-size: 30rpx;
  color: #ffd700;
  font-weight: 600;
}
