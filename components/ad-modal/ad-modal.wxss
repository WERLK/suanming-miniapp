/* ad-modal 组件样式 */

.ad-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.ad-modal-card {
  width: 620rpx;
  background: linear-gradient(160deg, #1a1a2e 0%, #2a2040 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  border: 2rpx solid rgba(255, 215, 0, 0.2);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.5);
  position: relative;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(60rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.ad-modal-close {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #8888a0;
  border-radius: 50%;
  z-index: 10;
}

.ad-modal-close:active {
  background: rgba(255, 255, 255, 0.1);
}

.ad-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffd700;
  text-align: center;
  margin-bottom: 24rpx;
}

/* 广告容器 */
.ad-modal-container {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 16rpx;
  min-height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  border: 1rpx dashed rgba(255, 255, 255, 0.1);
}

.ad-placeholder,
.ad-complete {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.ad-placeholder-icon {
  font-size: 60rpx;
  opacity: 0.6;
  animation: pulse 2s ease infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; }
}

.ad-placeholder-text {
  font-size: 26rpx;
  color: #8888a0;
}

.ad-complete-icon {
  font-size: 56rpx;
}

.ad-complete-text {
  font-size: 28rpx;
  color: #27ae60;
  font-weight: 500;
}

/* 倒计时进度条 */
.ad-timer-section {
  margin-bottom: 24rpx;
}

.ad-timer-bar-bg {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.ad-timer-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffd700, #f0a500);
  border-radius: 4rpx;
  transition: width 1s linear;
}

.ad-timer-info {
  text-align: center;
}

.ad-timer-text {
  font-size: 26rpx;
  color: #b0b0c8;
}

.ad-timer-ready {
  color: #ffd700;
  font-weight: 500;
  font-size: 28rpx;
}

.ad-provider-tag {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: #666;
  margin-top: 4rpx;
}

/* 领取按钮 */
.ad-claim-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #ffd700, #f0a500);
  color: #1a1a2e;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: all 0.3s ease;
}

.ad-claim-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.ad-claim-btn-disabled {
  background: rgba(255, 255, 255, 0.1);
  color: #666;
  font-weight: 400;
}

.ad-claim-btn-disabled:active {
  transform: none;
  opacity: 1;
}
