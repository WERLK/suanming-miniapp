/* 广告弹窗组件样式 */

.ad-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.85);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease;
}

.ad-overlay.active {
  opacity: 1;
  visibility: visible;
}

.ad-modal {
  width: 640rpx;
  background: #1a1a2e;
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 215, 0, 0.15);
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.5);
  overflow: hidden;
  position: relative;
}

.ad-close {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.ad-close-icon {
  font-size: 28rpx;
  color: #999;
}

.ad-content {
  padding: 40rpx 32rpx 32rpx;
}

.ad-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  color: #ffd700;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.ad-container {
  width: 100%;
  min-height: 300rpx;
  margin-bottom: 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.3);
}

/* 降级模式广告占位 */
.ad-fallback {
  width: 100%;
  margin-bottom: 24rpx;
}

.ad-placeholder {
  width: 100%;
  height: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(15, 12, 41, 0.6), rgba(40, 30, 80, 0.8));
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.ad-placeholder-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.ad-placeholder-text {
  font-size: 26rpx;
  color: #888;
  text-align: center;
  padding: 0 24rpx;
}

/* 进度条 */
.ad-progress {
  margin-bottom: 24rpx;
}

.ad-progress-bar {
  width: 100%;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.ad-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffd700, #f0a500);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.ad-progress-text {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #888;
}

/* 领取按钮 */
.ad-claim-btn {
  margin-top: 8rpx;
}
