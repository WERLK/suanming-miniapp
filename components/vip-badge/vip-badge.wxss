.vip-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  border-radius: 16rpx;
  background: rgba(26, 26, 46, 0.85);
}

.vip-badge.level-free {
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.vip-badge.level-basic {
  border: 1rpx solid rgba(255, 215, 0, 0.2);
  background: linear-gradient(135deg, rgba(26, 26, 46, 0.9), rgba(40, 30, 80, 0.95));
}

.vip-badge.level-permanent {
  border: 1rpx solid rgba(255, 215, 0, 0.4);
  background: linear-gradient(135deg, rgba(26, 26, 46, 0.9), rgba(60, 40, 20, 0.95));
  box-shadow: 0 4rpx 20rpx rgba(255, 215, 0, 0.15);
}

.vip-level-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.vip-level-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.vip-progress {
  width: 100%;
  margin-top: 4rpx;
}

.vip-progress-bar {
  width: 100%;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 6rpx;
}

.vip-progress-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

.level-free .vip-progress-fill {
  background: #888;
}

.level-basic .vip-progress-fill {
  background: linear-gradient(90deg, #ffd700, #f0a500);
}

.level-permanent .vip-progress-fill {
  background: linear-gradient(90deg, #ffd700, #ff6b6b);
}

.vip-progress-text {
  font-size: 22rpx;
  color: #888;
  display: block;
  text-align: center;
}

.vip-expires {
  font-size: 22rpx;
  color: #888;
  margin-top: 8rpx;
}
