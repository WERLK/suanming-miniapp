/* vip-badge 组件样式 */

.vip-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid currentColor;
  letter-spacing: 1rpx;
}

.vip-badge-sm {
  padding: 3rpx 14rpx;
  font-size: 20rpx;
  font-weight: 500;
  border-radius: 16rpx;
}
